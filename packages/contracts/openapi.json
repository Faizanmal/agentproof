{
  "components": {
    "schemas": {
      "Dependencies": {
        "additionalProperties": false,
        "properties": {
          "postgres": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Postgres",
            "type": "string"
          },
          "redis": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "postgres",
          "redis"
        ],
        "title": "Dependencies",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "alive",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Dependencies"
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Ready": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/Dependencies"
          },
          "status": {
            "enum": [
              "alive",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "Ready",
        "type": "object"
      },
      "Version": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "Version",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AgentProof API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version"
      }
    }
  }
}
