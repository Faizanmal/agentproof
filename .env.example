# Development only. Never use these database credentials in production.
APP_ENV=development
REGISTRATION_ENABLED=true
EMERGENCY_STOP_ENABLED=false
DATABASE_URL=postgresql+asyncpg://agentproof:agentproof_local_only@127.0.0.1:5432/agentproof # pragma: allowlist secret -- public local-only fixture
# Only needed when running the API container; use the same database credentials
# with host.docker.internal as host (Postgres must listen on the Docker host gateway).
DATABASE_URL_CONTAINER=postgresql+asyncpg://agentproof:agentproof_local_only@host.docker.internal:5432/agentproof # pragma: allowlist secret -- public local-only fixture
REDIS_URL=redis://127.0.0.1:6379/0
MAX_QUEUED_RUNS=1000
MAX_WORKSPACE_CONCURRENT_RUNS=1
EVENT_STREAM_CONCURRENCY_LIMIT=100
WORKER_LEASE_SECONDS=45
PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Set only after inspecting the real /v1/models response in a later phase.
VULTR_INFERENCE_MODEL=
VULTR_INFERENCE_API_KEY=
MASTER_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=
ARTIFACT_STORAGE_ROOT=./artifacts
BROKER_URL=http://127.0.0.1:8090
BROKER_HMAC_KEY=
# Broker operator settings (set only on the private sandbox VM, never in web/runner):
BROKER_BIND_HOST=127.0.0.1
BROKER_PORT=8090
BROKER_STATE_PATH=./.state/broker.sqlite3
BROKER_ARTIFACT_PATH=./.state/broker-artifacts
BROKER_RUNNER_IMAGE_DIGEST=
BROKER_SANDBOX_NETWORK=none
BROKER_MAX_CONCURRENT=1
BROKER_TLS_CERT=
BROKER_TLS_KEY=

# Bootstrap initializes random local keys only when the key fields above are empty.
MAIL_BACKEND=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ENCRYPTION_KEY_VERSION=1

# Authorization defaults; demo allowlist is administrative configuration, never request input.
AUTHORIZATION_TTL_SECONDS=2592000
CHALLENGE_TTL_SECONDS=1800
DEMO_MODE_ENABLED=false
PRODUCTION_DEMO_ENABLED=false
DEMO_ORIGINS=[]
# Owned local fixture only: after make demo-seed, use
# DEMO_MODE_ENABLED=true and DEMO_ORIGINS=["http://127.0.0.1:19090"]
# in a separate development instance. Never enable this allowlist in production.
# During rotation only: JSON map of old version to base64 32-byte key; never commit real keys.
ENCRYPTION_PREVIOUS_KEYS={}

# Sole API model gateway: bounded completion/retry/repair budget.
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_MAX_COMPLETION_TOKENS=4096
INFERENCE_MAX_CALLS=4
INFERENCE_TOTAL_TOKENS=32768
