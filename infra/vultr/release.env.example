# Copy to /etc/agentproof/release.env on app-vm (mode 600, deploy-owned).
# Paths must be absolute. Do not commit real values.
APP_ENV_FILE=/etc/agentproof/app.env
DB_ENV_FILE=/etc/agentproof/db.env
APP_DOMAIN=
ACME_EMAIL=
WEB_IMAGE=registry.example/agentproof-web@sha256:
API_IMAGE=registry.example/agentproof-api@sha256:
WORKER_IMAGE=registry.example/agentproof-worker@sha256:
