[Unit]
Description=AgentProof private sandbox broker
Documentation=file:///opt/agentproof/infra/sandbox/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/agentproof
EnvironmentFile=/etc/agentproof/broker.env
ExecStart=/opt/agentproof/.venv-broker/bin/agentproof-broker
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
# Broker holds Docker lifecycle for runners; limit blast radius of the process itself.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agentproof-broker /etc/agentproof
# Docker CLI must remain reachable for disposable runners.
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
