[Unit]
Description=AgentProof private sandbox broker
Documentation=file:///opt/agentproof/infra/sandbox/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/agentproof
EnvironmentFile=/etc/agentproof/broker.env
# Prefer module entry so a broken console-script shebang is easier to diagnose.
ExecStart=/opt/agentproof/.venv-broker/bin/python -m agentproof_broker.main
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStopSec=30
NoNewPrivileges=true
# Do not set ProtectHome=true: uv-managed CPython may live under /root/.local
# unless UV_PYTHON_INSTALL_DIR points at /opt/agentproof.
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/var/lib/agentproof-broker /opt/agentproof/.venv-broker /opt/agentproof/uv-python
# Docker Engine socket for disposable runners.
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
